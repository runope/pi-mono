{
	"name": "pi-monorepo",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*",
		"packages/web-ui/example",
		"packages/coding-agent/examples/extensions/with-deps",
		"packages/coding-agent/examples/extensions/custom-provider-anthropic",
		"packages/coding-agent/examples/extensions/custom-provider-gitlab-duo",
		"packages/coding-agent/examples/extensions/custom-provider-qwen-cli"
	],
	"scripts": {
		"clean": "bun run clean --filter '*'",
		"build": "bun run build:ai && bun run build:agent && bun run build:tui && bun run build:coding-agent && bun run build:mom && bun run build:web-ui && bun run build:pods",
		"build:ai": "cd packages/ai && bun run build",
		"build:agent": "cd packages/agent && bun run build",
		"build:tui": "cd packages/tui && bun run build",
		"build:coding-agent": "cd packages/coding-agent && bun run build",
		"build:mom": "cd packages/mom && bun run build",
		"build:web-ui": "cd packages/web-ui && bun run build",
		"build:pods": "cd packages/pods && bun run build",
		"check": "biome check --write --error-on-warnings . && bun run check:types && bun run check:browser-smoke && cd packages/web-ui && bun run check",
		"check:types": "tsc --noEmit",
		"check:browser-smoke": "bun scripts/check-browser-smoke.mjs",
		"test": "bun test",
		"dev": "bun run dev:ai & bun run dev:agent & bun run dev:coding-agent & bun run dev:mom & bun run dev:web-ui & bun run dev:tui",
		"dev:ai": "cd packages/ai && bun run dev",
		"dev:agent": "cd packages/agent && bun run dev",
		"dev:tui": "cd packages/tui && bun run dev",
		"dev:coding-agent": "cd packages/coding-agent && bun run dev",
		"dev:mom": "cd packages/mom && bun run dev",
		"dev:web-ui": "cd packages/web-ui && bun run dev",
		"release:patch": "bun scripts/release.mjs patch",
		"release:minor": "bun scripts/release.mjs minor",
		"release:major": "bun scripts/release.mjs major"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "^22.10.5",
		"typescript": "^5.9.2"
	},
	"engines": {
		"bun": ">=1.3.0"
	},
	"version": "0.0.3"
}
