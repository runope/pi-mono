{
	"name": "@runope/pi-mom",
	"version": "0.70.5",
	"description": "Slack bot that delegates messages to the pi coding agent",
	"type": "module",
	"bin": {
		"mom": "src/main.ts"
	},
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"files": [
		"src",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "bun shx rm -rf dist",
		"build": "bun build ./src/index.ts --outdir ./dist && bun shx chmod +x dist/main.js",
		"dev": "bun build ./src/index.ts --outdir ./dist --watch",
		"test": "bun test",
		"prepublishOnly": "bun run clean && bun run build"
	},
	"dependencies": {
		"@anthropic-ai/sandbox-runtime": "^0.0.16",
		"@runope/pi-agent-core": "^0.70.5",
		"@runope/pi-ai": "^0.70.5",
		"@runope/pi-coding-agent": "^0.70.5",
		"typebox": "^1.1.24",
		"@slack/socket-mode": "^2.0.0",
		"@slack/web-api": "^7.0.0",
		"chalk": "^5.6.2",
		"croner": "^9.1.0",
		"diff": "^8.0.2"
	},
	"devDependencies": {
		"@types/diff": "^7.0.2",
		"@types/node": "^24.3.0",
		"typescript": "^5.7.3",
		"vitest": "^3.2.4"
	},
	"keywords": [
		"slack",
		"bot",
		"ai",
		"agent"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/badlogic/pi-mono.git",
		"directory": "packages/mom"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
